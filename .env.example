# RealtorAI Configuration
# Copy this to .env and fill in your values

# =============================================================================
# Microsoft Graph API (Outlook)
# =============================================================================
# Register an app at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Required permissions: Mail.Read, Mail.Send, Calendars.ReadWrite
GRAPH_CLIENT_ID=your-client-id-here
GRAPH_TENANT_ID=common
# Note: Client secret is stored in macOS Keychain, not here

# =============================================================================
# Spark API (FlexMLS / MLS)
# =============================================================================
# Get API keys at https://sparkplatform.com/appstore/admin
SPARK_CLIENT_ID=
SPARK_CLIENT_SECRET=
# Demo token for testing with example data (no OAuth needed)
SPARK_DEMO_TOKEN=

# =============================================================================
# DocuSign Rooms + eSignature
# =============================================================================
# Get keys at https://developers.docusign.com/ (My Apps & Keys)
# Demo environment is the default; flip DOCUSIGN_BASE_URI for production.
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
# Demo: https://demo.rooms.docusign.com  |  Prod: https://rooms.docusign.com
DOCUSIGN_BASE_URI=https://demo.rooms.docusign.com
# 'mock' = local Rooms simulator (no broker API approval needed). 'live' = real API.
DOCUSIGN_BACKEND=mock

# =============================================================================
# MLS submission backend (Maine Listings / FlexMLS)
# =============================================================================
# 'mock' = draft listings stored locally. 'live' = Spark API (requires approval).
MLS_BACKEND=mock

# =============================================================================
# Public records
# =============================================================================
# Live FEMA flood determinations (keyless government APIs). Falls back to
# manual pull sheets on failure; set false for fully offline runs.
PUBLIC_RECORDS_LIVE=true

# =============================================================================
# Claude API (workflow automation: extraction, form fill, verification)
# =============================================================================
# Leave empty to run the mock demo fully offline — LLM steps degrade gracefully.
ANTHROPIC_API_KEY=
# Automatic model selection: structured work vs. high-stakes review
CLAUDE_MODEL_STANDARD=claude-sonnet-5
CLAUDE_MODEL_REVIEW=claude-opus-4-8

# =============================================================================
# Model Configuration
# =============================================================================
# Local MLX model (chat/email agent). HuggingFace model ID.
MODEL_NAME=Qwen/Qwen3-8B-MLX-4bit
MODEL_MAX_TOKENS=2048
MODEL_TEMPERATURE=0.7

# =============================================================================
# Application Settings
# =============================================================================
# Where to store data (relative to project root or absolute path)
DATA_DIR=data

# Web UI
WEB_HOST=127.0.0.1
WEB_PORT=8420

# Daemon
DAEMON_POLL_INTERVAL_SECONDS=120
DAEMON_SOCKET_PATH=/tmp/realtorai.sock

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR

# =============================================================================
# Development
# =============================================================================
DEBUG=false
